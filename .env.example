# Use EXATAMENTE estes nomes (duplo underscore mapeia seções aninhadas no .NET).
# Estes nomes também devem ser usados nas Run Configurations da IDE (Rider/VS).

# Database
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=laboratorios;Uid=user;Pwd=password

# AWS
AWS__AccessKey=your_access_key_here
AWS__SecretKey=your_secret_key_here
AWS__SessionToken=
AWS__Region=us-east-1
AWS__BucketName=your_bucket_name
